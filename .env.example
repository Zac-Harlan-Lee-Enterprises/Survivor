# Copy this file to .env.local and adjust. .env.local is gitignored.
#
# IMPORTANT: every VITE_* variable is compiled INTO the browser bundle and is
# therefore public. Never put AWS keys, API secrets, or sports-data API keys
# in a VITE_* variable. Secrets belong in the AWS backend (see infra/README.md).

# Runtime mode of the static frontend:
#   demo      — runs entirely from GitHub Pages with seeded fixtures and a
#               localStorage overlay (NOT authoritative multi-user persistence)
#   connected — talks to the AWS serverless API over HTTPS
VITE_DATA_MODE=demo

# Base path when hosted under a repository subpath, e.g. /Survivor/ for
# https://<org>.github.io/Survivor/ . Leave as / for a user/org site root.
# The GitHub Actions workflow sets this automatically from the repo name.
VITE_BASE_PATH=/

# --- Connected mode only (all values are public, non-secret identifiers) ---
# HTTPS base URL of the deployed API Gateway stage (no trailing slash).
VITE_API_BASE_URL=
# Cognito Hosted UI / OIDC settings (Authorization Code + PKCE, no client secret).
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_CLIENT_ID=
# Public base URL for headshot images (CloudFront or S3 website endpoint).
VITE_IMAGE_BASE_URL=
# Which league the deployed site opens by default.
VITE_DEFAULT_LEAGUE_ID=demo-league
