#!/usr/bin/env bash
# pre-commit — local gate for the harness.
#
# Install with:  bash scripts/install-hooks.sh
#
# Keep this hook FAST. Expensive project checks are PATH-GATED on the staged
# file list — a commit touching only claude-progress.txt must not pay for a
# typecheck. Heavy scans (playwright, knip, gitleaks) belong in CI.

set -uo pipefail

# Shared policy (secret patterns, protected branches) — single source of
# truth in scripts/lib/policy.sh; safe fallbacks if it is missing.
# shellcheck disable=SC1091
source scripts/lib/policy.sh 2>/dev/null || true
: "${PROTECTED_BRANCHES_RE:=(main|master|release(/[^[:space:]]*)?)}"
: "${SECRET_RE:=-----BEGIN [A-Z ]*PRIVATE KEY-----}"

EXIT=0
fail() { printf "\033[1;31m[pre-commit]\033[0m %s\n" "$*" >&2; EXIT=1; }
warn() { printf "\033[1;33m[pre-commit]\033[0m %s\n" "$*" >&2; }
info() { printf "\033[1;34m[pre-commit]\033[0m %s\n" "$*"; }

STAGED=$(git diff --cached --name-only --diff-filter=ACM)

# ---------------------------------------------------------------------------
# 1. Sensitive-path approval — NOT HERE. See scripts/hooks/commit-msg (the
#    message does not exist yet when pre-commit runs).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 1b. Refuse to commit on a protected branch
# ---------------------------------------------------------------------------
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
if [[ "$branch" =~ ^$PROTECTED_BRANCHES_RE$ ]]; then
  fail "Refusing to commit directly on protected branch '$branch'."
  echo "  → git switch -c feat/<slug>   # then re-commit" >&2
fi

# ---------------------------------------------------------------------------
# 2. Debug artifacts, conflict markers, secrets — one pass per staged file
# ---------------------------------------------------------------------------
while IFS= read -r f; do
  [[ -z "$f" ]] && continue
  content=$(git show ":$f" 2>/dev/null || true)

  case "$f" in
    src/*.ts|src/*.tsx|backend/src/*.ts)
      # console.log is a debug artifact in app code (warn/error/info are fine).
      if printf '%s' "$content" | grep -nE '(console\.log\(|^\s*debugger\b)' >/dev/null; then
        fail "Debug artifact (console.log/debugger) in staged file: $f"
      fi
      ;;
  esac

  if printf '%s' "$content" | grep -nE '^(<<<<<<< |=======$|>>>>>>> )' >/dev/null; then
    fail "Merge-conflict markers in staged file: $f"
  fi

  hits=$(printf '%s' "$content" | grep -nE "$SECRET_RE" | grep -v 'pragma: allowlist-secret' || true)
  if [[ -n "$hits" ]]; then
    fail "Possible secret in staged file: $f"
    echo "$hits" | head -5 | sed 's/^/      /' >&2
    echo "      → If intentional (local-dev only), append: pragma: allowlist-secret" >&2
  fi

  # Never commit the local env file or build output.
  case "$f" in
    .env|.env.local|.env.*.local|dist/*|dist-e2e/*|backend/dist/*)
      fail "Refusing to commit generated or local-only file: $f"
      ;;
  esac
done <<< "$STAGED"

# ---------------------------------------------------------------------------
# 3. Validate staged JSON / YAML config files
# ---------------------------------------------------------------------------
while IFS= read -r f; do
  [[ -z "$f" ]] && continue
  case "$f" in
    *.json)
      if command -v jq >/dev/null 2>&1 && ! git show ":$f" | jq empty >/dev/null 2>&1; then
        fail "Invalid JSON: $f"
      fi
      ;;
    *.yml|*.yaml)
      if ! git show ":$f" | node scripts/validate-yaml.mjs --stdin >/dev/null 2>&1; then
        fail "Invalid YAML: $f"
      fi
      ;;
  esac
done <<< "$STAGED"

# ---------------------------------------------------------------------------
# 4. Project gates — path-gated on the staged list, same flags as CI
# ---------------------------------------------------------------------------
if printf '%s\n' "$STAGED" | grep -qE '^(src/|backend/src/|build/|tests/|vite\.config\.ts|vitest\.config\.ts|tsconfig|package\.json|eslint\.config\.js)'; then
  # Staged-vs-worktree gap: tsc/eslint/vitest read the WORKTREE, not the
  # index. A partially staged source file would validate something other than
  # the commit — refuse rather than pretend.
  if git status --porcelain -- src backend/src build tests | grep -qE '^[ACMR]M'; then
    fail "Partially staged source files — stage or stash the remaining edits first:"
    git status --porcelain -- src backend/src build tests | grep -E '^[ACMR]M' | sed 's/^/      /' >&2
  else
    info "Source staged → typecheck + lint + architecture/unit tests (same flags as CI)"
    npm run -s typecheck >/dev/null 2>&1 || fail "TypeScript errors — run: npm run typecheck"
    npx eslint . >/dev/null 2>&1 || fail "ESLint errors — run: npm run lint"
    npx vitest run --reporter=dot >/dev/null 2>&1 || fail "Unit/architecture tests failed — run: npm test"
  fi
fi

if (( EXIT != 0 )); then
  echo >&2
  echo "Pre-commit checks failed. Fix the issues above (do NOT use --no-verify)." >&2
fi
exit "$EXIT"
