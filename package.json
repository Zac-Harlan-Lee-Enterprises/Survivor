{
  "name": "nfl-survivor-league",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NFL Survivor League \u2014 static React SPA for GitHub Pages with an optional AWS serverless backend.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "vite build --base=/Survivor/ --outDir dist-e2e",
    "preview": "vite preview",
    "serve:pages": "node scripts/serve-static.mjs --dir dist --base /Survivor/ --port 5892",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p backend/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:arch": "vitest run tests/architecture",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "knip": "knip",
    "fixtures:generate": "esbuild scripts/generate-demo-fixtures.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/generate-demo-fixtures.mjs --log-level=warning && node node_modules/.tmp/generate-demo-fixtures.mjs",
    "headshots:generate": "node scripts/generate-demo-headshots.mjs",
    "import:report": "esbuild scripts/import-report.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/import-report.mjs --log-level=warning && node node_modules/.tmp/import-report.mjs",
    "api:build": "node backend/build.mjs",
    "api:test": "vitest run backend",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run build",
    "api:seed": "esbuild scripts/seed-league.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.tmp/seed-league.mjs --log-level=warning && node node_modules/.tmp/seed-league.mjs",
    "headshots:import": "node scripts/import-headshots.mjs",
    "schedule:fetch": "node scripts/fetch-nfl-schedule.mjs",
    "logos:fetch": "node scripts/fetch-team-logos.mjs",
    "build:e2e:readonly": "vite build --base=/Survivor/ --outDir dist-e2e-readonly"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-query": "^5.102.8",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.43.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1127.0",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/lib-dynamodb": "^3.1127.0",
    "@aws-sdk/s3-presigned-post": "^3.1127.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/aws-lambda": "^8.10.163",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "yaml": "^2.9.0"
  }
}
